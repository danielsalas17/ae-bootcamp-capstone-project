# Backend server port
PORT=4000

# OMDb API key - get one free at http://www.omdbapi.com/apikey.aspx
# Never commit your real key.
OMDB_API_KEY=your_omdb_api_key_here

# TMDB API key (v3 auth) - get one free at https://www.themoviedb.org/settings/api
# Used for the popular-movies, movie search, and movie details endpoints. Never commit your real key.
TMDB_API_KEY=your_tmdb_api_key_here
